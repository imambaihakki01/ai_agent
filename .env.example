APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=8000
APP_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
DASHBOARD_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
COOKIE_SECURE=true
SESSION_MAX_AGE=43200
